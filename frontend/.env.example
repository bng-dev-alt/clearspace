# Supabase Configuration
# Project Settings -> Data API (URL) a API Keys (publishable / anon key).
# Když zůstanou prázdné, aplikace běží v demo režimu nad localStorage.
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Vynutí demo režim (localStorage + mock auth) i s vyplněnými klíči výše.
# Používá to E2E sada; hodí se i na ukázku aplikace bez backendu.
# NEXT_PUBLIC_FORCE_DEMO=1

# Google Gemini Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
